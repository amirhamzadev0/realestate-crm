# Exact browser origin (scheme + host + port). Used for POST origin checks and the secure cookie flag.
APP_ORIGIN=http://127.0.0.1:3130
# Canonical public URL.
SITE_URL=http://127.0.0.1:3130

# mock  = in-memory demo data; sign-in comes from .private/users.json (npm run users:setup)
# mysql = MySQL database (needs DATABASE_URL); sign-in comes from the users table
DATA_STORAGE=mock

# DATABASE_URL=mysql://username:password@127.0.0.1:3306/buildflow_crm

# Email domain for the accounts created by npm run users:setup.
# LOGIN_EMAIL_DOMAIN=buildflow.local

# Sign-in is off unless this is true. While off, everyone is the Super Admin and the home page lists the four portals.
AUTH_ENABLED=false
